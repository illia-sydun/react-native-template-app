{
    "name": "react-native-template-app",
    "main": "expo-router/entry",
    "version": "1.0.0",
    "scripts": {
        "start": "expo start -c",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "test": "jest --watchAll",
        "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint \"*.{ts,tsx,js,jsx}\" --fix --max-warnings 0",
        "prettier": "prettier --write '*.{js,jsx,ts,tsx,json,css,scss,html}' --config ./.prettierrc",
        "prepare": "husky",
        "build:ios": "eas build --profile development-simulator --platform ios",
        "build:android": "eas build --profile development --platform android",
        "build:android:beta": "eas build --profile beta --platform android"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json}": [
            "bash -c 'tsc'",
            "npm run lint:fix"
        ],
        "*.{js,jsx,ts,tsx,json,html,scss}": [
            "npm run prettier"
        ]
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "jest": {
        "preset": "jest-expo"
    },
    "dependencies": {
        "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
        "@clerk/clerk-expo": "^2.0.5",
        "@expo/vector-icons": "^14.0.0",
        "@gorhom/bottom-sheet": "^4.6.4",
        "@hookform/resolvers": "^3.9.0",
        "@react-native-masked-view/masked-view": "0.3.1",
        "@react-navigation/native": "^6.0.2",
        "@react-navigation/stack": "^6.4.1",
        "@rn-primitives/alert-dialog": "^1.0.3",
        "@rn-primitives/checkbox": "^1.0.3",
        "@rn-primitives/dropdown-menu": "^1.0.3",
        "@rn-primitives/label": "^1.0.3",
        "@rn-primitives/popover": "^1.0.3",
        "@rn-primitives/portal": "^1.0.3",
        "@rn-primitives/radio-group": "^1.0.3",
        "@rn-primitives/select": "^1.0.4",
        "@rn-primitives/slot": "^1.0.3",
        "@rn-primitives/switch": "^1.0.3",
        "@rn-primitives/tooltip": "^1.0.3",
        "@rn-primitives/types": "^1.0.3",
        "@shopify/flash-list": "1.6.4",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.1",
        "expo": "~51.0.9",
        "expo-blur": "~13.0.2",
        "expo-constants": "~16.0.2",
        "expo-crypto": "~13.0.2",
        "expo-dev-client": "~4.0.15",
        "expo-font": "~12.0.6",
        "expo-linking": "~6.3.1",
        "expo-localization": "~15.0.3",
        "expo-navigation-bar": "~3.0.7",
        "expo-router": "~3.5.15",
        "expo-splash-screen": "~0.27.4",
        "expo-status-bar": "~1.12.1",
        "expo-system-ui": "~3.0.4",
        "expo-web-browser": "~13.0.3",
        "i18next": "^23.11.5",
        "lucide-react-native": "^0.424.0",
        "nativewind": "^4.0.1",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-hook-form": "^7.52.2",
        "react-i18next": "^14.1.2",
        "react-native": "0.74.1",
        "react-native-gesture-handler": "~2.16.1",
        "react-native-mask-input": "^1.2.3",
        "react-native-mmkv": "^2.12.2",
        "react-native-reanimated": "~3.10.1",
        "react-native-redash": "^18.1.3",
        "react-native-safe-area-context": "4.10.1",
        "react-native-screens": "3.31.1",
        "react-native-svg": "15.2.0",
        "react-native-ui-lib": "^7.23.2",
        "react-native-web": "~0.19.10",
        "tailwind-merge": "^2.4.0",
        "tailwindcss": "^3.4.3",
        "tailwindcss-animate": "^1.0.7",
        "zod": "^3.23.8",
        "zustand": "^4.5.4"
    },
    "devDependencies": {
        "@babel/core": "^7.20.0",
        "@types/jest": "^29.5.12",
        "@types/react": "~18.2.45",
        "@types/react-i18next": "^8.1.0",
        "@types/react-test-renderer": "^18.0.7",
        "eslint": "^8.57.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-config-airbnb-typescript": "^18.0.0",
        "eslint-config-expo": "^7.0.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "husky": "^9.0.11",
        "jest": "^29.2.1",
        "jest-expo": "~51.0.1",
        "lint-staged": "^15.2.5",
        "prettier": "^3.3.0",
        "react-test-renderer": "18.2.0",
        "typescript": "~5.3.3"
    },
    "private": true
}
